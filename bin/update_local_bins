#!/usr/bin/env bash

# MISE_USE_VERSIONS_HOST=false

exists() {
    command -v "$1" >/dev/null 2>&1
}

update_claude() {
    if exists claude; then
        echo "Updating claude..."
        claude update
    fi
}

update_agy() {
    if exists agy; then
        echo "Updating agy..."
        agy update
    fi
}

update_mise() {
    if exists mise; then
        echo "Updating mise..."
        export MISE_CONFIG_FILE="${HOME}/.config/mise/config.toml"
        if [[ -z "${GITHUB_TOKEN:-}" && -f "${HOME}/.config/mise/github_token" ]]; then
            export GITHUB_TOKEN
            GITHUB_TOKEN="$(<"${HOME}/.config/mise/github_token")"
        fi
        mise cache clear
        mise self-update -y
        rm "${HOME}/.config/mise/mise.lock"
        mise upgrade
        mise reshim
        mise lock -g
    fi
}

