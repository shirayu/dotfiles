#!/usr/bin/env bash

# MISE_USE_VERSIONS_HOST=false

set -u -o pipefail

trap 'echo "Interrupted."; exit 130' INT

exists() {
    command -v "$1" >/dev/null 2>&1
}

# 各 update_* はサブシェルで実行されるため、export は他のターゲットに漏れない。
# 実行順を保った対応表 (update_<target> という関数名に対応)
TARGETS=(claude agy mise gh uv npm pnpm flatpak)

update_claude() {
    exists claude || return 0
    echo "Updating claude..."
    claude update
}

update_agy() {
    exists agy || return 0
    echo "Updating agy..."
    agy update
}

update_mise() {
    exists mise || return 0
    echo "Updating mise..."
    export MISE_CONFIG_FILE="${HOME}/.config/mise/config.toml"
    if [[ -z ${GITHUB_TOKEN:-} && -f "${HOME}/.config/mise/github_token" ]]; then
        export GITHUB_TOKEN
        GITHUB_TOKEN="$(<"${HOME}/.config/mise/github_token")"
    fi
    local lock="${HOME}/.config/mise/mise.lock"
    local backup=""
    if [[ -f ${lock} ]]; then
        backup="${lock}.bak"
        mv -f "${lock}" "${backup}"
    fi
    mise cache clear || true
    mise self-update -y || true
    if mise upgrade; then
        mise reshim
        mise lock -g
        [[ -n ${backup} ]] && rm -f "${backup}"
        return 0
    fi
    # 失敗時は lock ファイルを元に戻す
    if [[ -n ${backup} ]]; then
        mv -f "${backup}" "${lock}"
    fi
    return 1
}

update_gh() {
    exists gh || return 0
    echo "Updating gh extensions..."
    local extensions
    extensions="$(gh extension list)" || return 1
    if [[ ${extensions} == *gfm-preview* ]]; then
        gh extension upgrade gfm-preview
    else
        gh extension install thiagokokada/gh-gfm-preview
    fi
}

update_uv() {
    exists uv || return 0
    echo "Updating uv tools..."
    export UV_HTTP_TIMEOUT=${UV_HTTP_TIMEOUT:-600}
    uv tool upgrade --all
}

update_npm() {
    exists npm || return 0
    echo "Updating npm global packages..."
    npm -g upgrade
    # corepack は mise/pnpm 側で管理するため、npm 同梱のものは毎回削除する
    npm -g uninstall corepack || true
}

update_pnpm() {
    exists pnpm || return 0
    echo "Updating pnpm global packages..."
    pnpm -g up --latest
}

update_flatpak() {
    exists flatpak || return 0
    echo "Updating flatpak..."
    flatpak update -y
    flatpak uninstall --unused -y
}

usage() {
    echo "Usage: $(basename "$0") [--skip TARGET]... [TARGET...]"
    echo "Targets: ${TARGETS[*]}"
    echo "  (no args = update everything)"
    echo "  --skip TARGET  exclude TARGET (repeatable)"
}

is_target() {
    local t
    for t in "${TARGETS[@]}"; do
        [[ $t == "$1" ]] && return 0
    done
    return 1
}

die_unknown() {
    echo "Unknown target: $1" >&2
    usage >&2
    exit 1
}

# 引数解析
requested=()
skipped=()
while (($# > 0)); do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --skip)
            if (($# < 2)); then
                echo "--skip requires a TARGET" >&2
                usage >&2
                exit 1
            fi
            is_target "$2" || die_unknown "$2"
            skipped+=("$2")
            shift 2
            ;;
        *)
            is_target "$1" || die_unknown "$1"
            requested+=("$1")
            shift
            ;;
    esac
done

if ((${#requested[@]} == 0)); then
    requested=("${TARGETS[@]}")
fi

is_skipped() {
    local s
    for s in "${skipped[@]}"; do
        [[ $s == "$1" ]] && return 0
    done
    return 1
}

FAILED=()
SUMMARY=()
for t in "${requested[@]}"; do
    if ((${#skipped[@]} > 0)) && is_skipped "${t}"; then
        continue
    fi
    start=${SECONDS}
    # サブシェルで実行し、環境変数の export を隔離する
    if ("update_${t}"); then
        status="ok"
    else
        status="FAILED"
        echo "Failed: ${t}" >&2
        FAILED+=("${t}")
    fi
    SUMMARY+=("$(printf '%-8s %-6s %ss' "${t}" "${status}" "$((SECONDS - start))")")
done

if ((${#SUMMARY[@]} > 0)); then
    echo
    echo "Summary:"
    printf '  %s\n' "${SUMMARY[@]}"
fi

if ((${#FAILED[@]} > 0)); then
    echo "Some updates failed: ${FAILED[*]}" >&2
    exit 1
fi

echo "All updates completed!"
