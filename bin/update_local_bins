update_gh() {
    if exists gh; then
        echo "Updating gh extensions..."
        if gh extension list | grep -q "gfm-preview"; then
            gh extension upgrade gfm-preview
        else
            gh extension install thiagokokada/gh-gfm-preview
        fi
    fi
}

update_uv() {
    if exists uv; then
        echo "Updating uv tools..."
        export UV_HTTP_TIMEOUT=${UV_HTTP_TIMEOUT:-600}
        uv tool upgrade --all
    fi
}

update_npm() {
    if exists npm; then
        echo "Updating npm global packages..."
        npm -g upgrade
        npm -g uninstall corepack || true
    fi
}

update_pnpm() {
    if exists pnpm; then
        echo "Updating pnpm global packages..."
        pnpm -g up --latest
    fi
}

update_flatpak() {
    if exists flatpak; then
        echo "Updating flatpak..."
        flatpak update -y
        flatpak uninstall --unused -y
    fi
}

# 実行順を保った対応表
TARGETS=(claude agy mise gh uv npm pnpm flatpak)

usage() {
    echo "Usage: $(basename "$0") [TARGET...]"
    echo "Targets: ${TARGETS[*]}"
    echo "  (no args = update everything)"
}

run_target() {
    case "$1" in
        claude) update_claude ;;
        agy) update_agy ;;
        mise) update_mise ;;
        gh) update_gh ;;
        uv) update_uv ;;
        npm) update_npm ;;
        pnpm) update_pnpm ;;
        flatpak) update_flatpak ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown target: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
}

if [[ $# -eq 0 ]]; then
    for t in "${TARGETS[@]}"; do
        run_target "$t"
    done
else
    for t in "$@"; do
        run_target "$t"
    done
fi

echo "All updates completed!"
