#!/usr/bin/env python3
"""Fetch and pretty-print ChatGPT/Codex usage & rate-limit-reset-credit info.

Use --cache to skip re-downloading and just render the last dump in
~/.codex/dump/.
"""

import argparse
import io
import json
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from urllib.request import Request, urlopen

DUMP_DIR = Path.home() / ".codex" / "dump"
AUTH_PATH = Path.home() / ".codex" / "auth.json"

ENDPOINTS = {
    "rate-limit-reset-credits.json": "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits",
    "usage.json": "https://chatgpt.com/backend-api/wham/usage",
}


class Ansi:
    enabled = sys.stdout.isatty()

    @classmethod
    def wrap(cls, code, s):
        return f"\033[{code}m{s}\033[0m" if cls.enabled else str(s)

    @classmethod
    def bold(cls, s):
        return cls.wrap("1", s)

    @classmethod
    def dim(cls, s):
        return cls.wrap("2", s)

    @classmethod
    def red(cls, s):
        return cls.wrap("31", s)

    @classmethod
    def green(cls, s):
        return cls.wrap("32", s)

    @classmethod
    def visible_len(cls, s):
        """Length ignoring ANSI escape codes, for column alignment."""
        out, in_esc = 0, False
        for ch in s:
            if ch == "\033":
                in_esc = True
            elif in_esc:
                in_esc = ch != "m"
            else:
                out += 1
        return out


def parse_ts(value):
    """Parse an epoch-seconds number or ISO-8601 string into an aware UTC datetime."""
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, tz=timezone.utc)
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None


def fmt_ts(value):
    dt = parse_ts(value)
    return dt.astimezone().strftime("%Y-%m-%d %H:%M:%S %Z") if dt else "-"


def fmt_duration(seconds):
    if seconds is None:
        return "-"
    seconds = int(seconds)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    clock = f"{hours:02}:{minutes:02}:{seconds:02}"
    return f"{days}d {clock}" if days else clock


def color_by_urgency(seconds, text):
    """Color where LESS time left is worse (e.g. a voucher about to expire)."""
    if seconds <= 0:
        return Ansi.red(text)
    if seconds < 86400:
        return Ansi.red(text)
    if seconds < 3 * 86400:
        return Ansi.wrap("33", text)
    return Ansi.green(text)


def color_by_relief(seconds, text):
    """Color where MORE time left is worse (e.g. time until a rate limit resets)."""
    if seconds < 86400:
        return Ansi.green(text)
    if seconds < 3 * 86400:
        return Ansi.wrap("33", text)
    return Ansi.red(text)


def fmt_days(seconds):
    if seconds is None:
        return "-"
    return f"{int(seconds) // 86400}d"


def fmt_time_until(value):
    dt = parse_ts(value)
    if dt is None:
        return "-"
    remaining = (dt - datetime.now(timezone.utc)).total_seconds()
    text = "expired" if remaining <= 0 else fmt_duration(remaining)
    return color_by_urgency(remaining, text)


def fmt_pct(p):
    if p is None:
        return "-"
    color = Ansi.red if p >= 90 else (lambda s: Ansi.wrap("33", s)) if p >= 50 else Ansi.green
    return color(f"{p}%")


def fmt_remaining_pct(used_percent):
    if used_percent is None:
        return "-"
    remaining = 100 - float(used_percent)
    if remaining < 0:
        remaining = 0.0
    if remaining > 100:
        remaining = 100.0
    remaining_int = int(remaining)
    color = Ansi.green if remaining > 50 else (lambda s: Ansi.wrap("33", s)) if remaining > 10 else Ansi.red
    return color(f"{remaining_int}%")


def short_id(full_id):
    return full_id.rsplit("_", 1)[-1][:10]


class Table:
    def __init__(self, headers):
        self.headers = headers
        self.rows = []

    def add_row(self, *cells):
        self.rows.append([str(cell) for cell in cells])

    def print(self, file=sys.stdout):
        widths = [len(h) for h in self.headers]
        for row in self.rows:
            for i, cell in enumerate(row):
                widths[i] = max(widths[i], Ansi.visible_len(cell))

        def rule():
            print("+" + "+".join("-" * (w + 2) for w in widths) + "+", file=file)

        def print_row(cells):
            padded = [f" {cell}{' ' * (w - Ansi.visible_len(cell))} " for cell, w in zip(cells, widths)]
            print("|" + "|".join(padded) + "|", file=file)

        rule()
        print_row([Ansi.bold(h) for h in self.headers])
        rule()
        for row in self.rows:
            print_row(row)
        rule()


def section(title, file=sys.stdout):
    print(file=file)
    print(Ansi.bold(title), file=file)


def fetch(
    outdir,
    sleep: float,
):
    token = json.loads(AUTH_PATH.read_text())["tokens"]["access_token"]
    outdir.mkdir(parents=True, exist_ok=True)

    for i, (filename, url) in enumerate(ENDPOINTS.items()):
        if i > 0:
            time.sleep(sleep)
        req = Request(
            url,
            headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
        )
        data = json.loads(urlopen(req, timeout=30).read())
        (outdir / filename).write_text(json.dumps(data, indent=2) + "\n")


def load_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        print(f"(failed to parse {path.name}: {e})", file=sys.stderr)
        return None


@dataclass
class Dump:
    usage: dict
    reset_credits: dict


def load_dump(dump_dir):
    usage = load_json(dump_dir / "usage.json") or {}
    reset_credits = load_json(dump_dir / "rate-limit-reset-credits.json") or {}
    if not usage and not reset_credits:
        print(f"No dump files found in {dump_dir}", file=sys.stderr)
        sys.exit(1)
    return Dump(usage=usage, reset_credits=reset_credits)


def print_account_line(usage, file=sys.stdout):
    limit_reached = (usage.get("rate_limit") or {}).get("limit_reached")
    status = Ansi.bold(Ansi.red("LIMIT REACHED")) if limit_reached else Ansi.green("ok")
    print(
        f"{Ansi.bold(usage.get('email', '-'))}  plan={usage.get('plan_type', '-')}  status={status}",
        file=file,
    )


def print_rate_limits(usage, file=sys.stdout):
    section("Rate limits", file=file)
    table = Table(["limit", "window", "remaining", "period", "resets in", "reset at"])

    def add_windows(label, rate_limit):
        for win_name in ("primary_window", "secondary_window"):
            win = (rate_limit or {}).get(win_name)
            if win is None:
                continue
            reset_after = win.get("reset_after_seconds")
            table.add_row(
                label,
                win_name.removesuffix("_window"),
                fmt_remaining_pct(win.get("used_percent")),
                fmt_days(win.get("limit_window_seconds")),
                color_by_relief(reset_after, fmt_duration(reset_after)) if reset_after is not None else "-",
                fmt_ts(win.get("reset_at")),
            )

    add_windows("default", usage.get("rate_limit"))
    for extra in usage.get("additional_rate_limits") or []:
        add_windows(extra.get("limit_name", "-"), extra.get("rate_limit"))

    if table.rows:
        table.print(file=file)
    else:
        print("  (none)", file=file)


def print_credits(usage, file=sys.stdout):
    section("Credits", file=file)
    credits = usage.get("credits") or {}
    reset_credits = usage.get("rate_limit_reset_credits") or {}

    table = Table(
        [
            "balance",
            "has_credits",
            "unlimited",
            "reset_credits avail",
            "reset_credits applicable",
        ]
    )
    table.add_row(
        credits.get("balance", "-"),
        credits.get("has_credits", "-"),
        credits.get("unlimited", "-"),
        reset_credits.get("available_count", "-"),
        reset_credits.get("applicable_available_count", "-"),
    )
    table.print(file=file)

    upsell = usage.get("rate_limit_upsell")
    if upsell:
        print(
            f"  {Ansi.dim(upsell.get('title', ''))}: {upsell.get('description', '')}",
            file=file,
        )


def print_vouchers(reset_credits, file=sys.stdout):
    section(
        f"Reset-credit vouchers (earned total: {reset_credits.get('total_earned_count', 0)})",
        file=file,
    )
    table = Table(["id", "status", "type", "granted", "expires", "expires in", "redeemed"])

    for voucher in reset_credits.get("credits") or []:
        status = voucher.get("status", "")
        status_disp = Ansi.green(status) if status == "available" else status
        table.add_row(
            short_id(voucher.get("id", "")),
            status_disp,
            voucher.get("reset_type", "-"),
            fmt_ts(voucher.get("granted_at")),
            fmt_ts(voucher.get("expires_at")),
            fmt_time_until(voucher.get("expires_at")),
            fmt_ts(voucher.get("redeemed_at")),
        )

    if table.rows:
        table.print(file=file)
    else:
        print("  (none)", file=file)


def render(dump_dir, file=sys.stdout):
    dump = load_dump(dump_dir)
    print_account_line(dump.usage, file=file)
    print_rate_limits(dump.usage, file=file)
    print_vouchers(dump.reset_credits, file=file)
    print_credits(dump.usage, file=file)
    print(file=file)


def render_zabbix(dump_dir, file=sys.stdout):
    dump = load_dump(dump_dir)
    usage = dump.usage or {}
    reset_credits = dump.reset_credits or {}

    rate_limit_main = usage.get("rate_limit") or {}
    limit_reached = rate_limit_main.get("limit_reached", False)

    def window_period_alias(limit_window_seconds):
        """Map a window length in seconds to a human-readable period alias."""
        if limit_window_seconds is None:
            return None
        return {
            3600: "hourly",
            18000: "five_hour",
            86400: "daily",
            604800: "week",
        }.get(int(limit_window_seconds))

    def extract_windows(rl_dict):
        res = {}
        for win_name in ("primary_window", "secondary_window"):
            win = (rl_dict or {}).get(win_name)
            if win is None:
                continue
            entry = {
                "used_percent": win.get("used_percent"),
                "limit_window_seconds": win.get("limit_window_seconds"),
                "reset_after_seconds": win.get("reset_after_seconds"),
                "reset_at": win.get("reset_at"),
            }
            alias = window_period_alias(win.get("limit_window_seconds"))
            res[alias or win_name.removesuffix("_window")] = entry
        return res

    rate_limits_data = extract_windows(rate_limit_main)

    rate_limits_extra = {}
    for extra in usage.get("additional_rate_limits") or []:
        name = extra.get("limit_name")
        if name:
            rate_limits_extra[name] = extract_windows(extra.get("rate_limit"))

    credits_info = usage.get("credits") or {}
    rl_credits_info = usage.get("rate_limit_reset_credits") or {}

    vouchers_list = []
    available_vouchers_count = 0
    now_utc = datetime.now(timezone.utc)

    for v in reset_credits.get("credits") or []:
        st = v.get("status")
        if st == "available":
            available_vouchers_count += 1

        expires_at_dt = parse_ts(v.get("expires_at"))
        remaining = (expires_at_dt - now_utc).total_seconds() if expires_at_dt else None

        vouchers_list.append(
            {
                "id": v.get("id"),
                "status": st,
                "reset_type": v.get("reset_type"),
                "granted_at": v.get("granted_at"),
                "expires_at": v.get("expires_at"),
                "expires_in_seconds": round(remaining) if remaining is not None else None,
                "redeemed_at": v.get("redeemed_at"),
            }
        )

    lasteupdate: int = int(now_utc.timestamp())
    data = {
        "lastupdate": lasteupdate,
        "lastupdate_text": datetime.fromtimestamp(lasteupdate).strftime("%Y-%m-%d %H:%M:%S"),
        "email": usage.get("email"),
        "plan_type": usage.get("plan_type"),
        "limit_reached": bool(limit_reached),
        "rate_limits": rate_limits_data,
        "rate_limits_extra": rate_limits_extra,
        "credits": {
            "balance": credits_info.get("balance"),
            "has_credits": credits_info.get("has_credits"),
            "unlimited": credits_info.get("unlimited"),
            "available_count": rl_credits_info.get("available_count"),
            "applicable_available_count": rl_credits_info.get("applicable_available_count"),
        },
        "vouchers": {
            "total_earned_count": reset_credits.get("total_earned_count", 0),
            "available_count": available_vouchers_count,
            "list": vouchers_list,
        },
    }
    print(json.dumps(data, indent=2, ensure_ascii=False), file=file)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        default=Path("/dev/stdout"),
        help="output file path (default: /dev/stdout)",
    )
    parser.add_argument(
        "--cache",
        action="store_true",
        help="skip re-downloading; render the existing dump in ~/.codex/dump/",
    )
    parser.add_argument(
        "--sleep",
        type=float,
        default=0.1,
        help="sleep time",
    )
    parser.add_argument(
        "--zabix",
        "--zabbix",
        action="store_true",
        dest="zabbix",
        help="output JSON format for Zabbix monitoring",
    )
    args = parser.parse_args()

    if not args.cache:
        fetch(DUMP_DIR, args.sleep)

    if str(args.output) == "/dev/stdout":
        Ansi.enabled = sys.stdout.isatty()
        if args.zabbix:
            render_zabbix(DUMP_DIR, file=sys.stdout)
        else:
            render(DUMP_DIR, file=sys.stdout)
    else:
        buf = io.StringIO()
        Ansi.enabled = False
        if args.zabbix:
            render_zabbix(DUMP_DIR, file=buf)
        else:
            render(DUMP_DIR, file=buf)

        if args.output.parent:
            args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(buf.getvalue(), encoding="utf-8")


if __name__ == "__main__":
    main()
